{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.md",
      "**/*.txt",
      "**/*.log"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/login",
        "destination": "/login.html"
      },
      {
        "source": "/issue/**",
        "destination": "/portal.html"
      },
      {
        "source": "/track/**",
        "destination": "/portal.html"
      },
      {
        "source": "/me/**",
        "destination": "/portal.html"
      },
      {
        "source": "**",
        "destination": "/portal.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }
}
